{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "puck",
  "description": "Minimum capabilities required by the RepoPuck desktop puck",
  "windows": ["puck"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
