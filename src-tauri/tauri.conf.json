{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoPuck",
  "version": "0.1.0",
  "identifier": "com.repopuck.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "RepoPuck",
        "url": "index.html?view=panel",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "puck",
        "title": "RepoPuck",
        "url": "index.html?view=puck",
        "width": 58,
        "height": 58,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
